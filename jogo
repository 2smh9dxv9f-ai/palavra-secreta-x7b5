const MAX = 8, HINT_COST = 25;
const norm = s => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,"").replace(/[^a-z0-9]/g,"");
const $ = id => document.getElementById(id);

const PACKS = [100,300,500,1000];
const PRICE_PER_100 = 5; // R$ 5,00 a cada 100 tokens
const brl = v => "R$ " + v.toFixed(2).replace(".",",");
try { const t = parseInt(localStorage.getItem("tokens")); if (!isNaN(t) && t >= 0) var savedTokens = t; } catch(e){}
function saveTokens(){ try { localStorage.setItem("tokens", String(coins)); } catch(e){} }
let randomMode = false, cat = "Marcas de Luxo", list = [], ansIdx = 0, guesses = [], coins = (typeof savedTokens === 'number' ? savedTokens : 300), done = false, revealed = new Set();

function sortedList(name){
  return LISTS[name].slice().sort((a,b)=>norm(a).localeCompare(norm(b),"pt-BR"));
}
function newGame(){
  if (randomMode){ const ks = Object.keys(LISTS); cat = ks[Math.floor(Math.random()*ks.length)]; }
  list = sortedList(cat);
  ansIdx = Math.floor(Math.random()*list.length);
  guesses = []; done = false; revealed = new Set();
  $("title").textContent = cat;
  $("msg").className = "msg"; $("msg").innerHTML = "";
  $("inp").value = ""; $("inp").disabled = false; $("send").disabled = false; $("hint").disabled = false;
  render();
}
function colorClass(d){
  const r = d / list.length;
  if (r <= .04) return "c1";
  if (r <= .15) return "c2";
  if (r <= .30) return "c3";
  return "c4";
}
const UP = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15l7-7 7 7"/></svg>';
const DOWN = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l7 7 7-7"/></svg>';

function render(){
  $("coins").textContent = coins;
  $("tries").textContent = "Tentativas: " + guesses.length + "/" + MAX;
  $("catName").textContent = cat + (randomMode ? " (aleatório)" : "");
  // board: guesses sorted alphabetically with "?" slot
  const items = guesses.map(i=>({i, g:true}));
  if (!done) items.push({i:ansIdx, g:false});
  items.sort((a,b)=>a.i-b.i);
  const COL = {c1:"#ff6b6b",c2:"#ffa94d",c3:"#4dabf7",c4:"#5c6b8a"};
  $("board").innerHTML = items.map(it=>{
    if (!it.g) return '<div class="row unk"><div class="name">a resposta fica aqui</div><div class="dist">?</div></div>';
    const d = Math.abs(it.i - ansIdx);
    if (d === 0) return '<div class="row win" style="--c:#34d399"><div class="name">'+esc(list[it.i])+'</div><div class="dist"><span class="arr">✓</span></div><i class="meter"><b style="width:100%"></b></i></div>';
    const arrow = ansIdx > it.i ? "↓" : "↑";
    const pct = Math.max(4, Math.round((1 - d/list.length)*100));
    return '<div class="row" style="--c:'+COL[colorClass(d)]+'"><div class="name">'+esc(list[it.i])+'</div><div class="dist"><span class="arr">'+arrow+'</span><span>'+d+'</span></div><i class="meter"><b style="width:'+pct+'%"></b></i></div>';
  }).join("");
  // pattern
  const ans = list[ansIdx];
  $("pattern").innerHTML = [...ans].map((ch,k)=>{
    if (ch === " ") return '<span class="pl sp"></span>';
    const show = done || revealed.has(k) || !/[\p{L}\p{N}]/u.test(ch);
    return '<span class="pl">'+(show?esc(ch.toUpperCase()):"")+'</span>';
  }).join("");
  updateSug();
}
function esc(s){ return s.replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }
function toast(t){ const el=$("toast"); el.textContent=t; el.classList.add("show"); clearTimeout(toast.t); toast.t=setTimeout(()=>el.classList.remove("show"),2200); }

function updateSug(){}
function submit(forceIdx){
  if (done) return;
  let idx = forceIdx;
  if (idx === undefined){
    const q = norm($("inp").value);
    if (!q) return;
    idx = list.findIndex(n=>norm(n)===q);
    if (idx < 0){ toast("Palavra não encontrada no jogo"); return; }
  }
  if (guesses.includes(idx)){ toast("Você já tentou esse"); return; }
  guesses.push(idx);
  $("inp").value = "";
  if (idx === ansIdx) finish(true);
  else if (guesses.length >= MAX) finish(false);
  render();
}
function finish(win){
  done = true;
  if (win){ coins += 10; saveTokens(); }
  $("inp").disabled = true; $("send").disabled = true; $("hint").disabled = true;
  const m = $("msg");
  m.className = "msg show " + (win?"ok":"no");
  m.innerHTML = (win ? "🎉 Acertou em " + guesses.length + (guesses.length===1?" tentativa!":" tentativas!") + " +10 tokens" : "A resposta era: " + esc(list[ansIdx])) +
    '<button class="again" id="again">Jogar de novo</button>';
  $("again").onclick = newGame;
}
$("send").onclick = ()=>submit();
$("inp").addEventListener("input", updateSug);
$("inp").addEventListener("keydown", e=>{ if(e.key==="Enter"){ e.preventDefault(); submit(); } });
$("hint").onclick = ()=>{
  if (done) return;
  if (coins < HINT_COST){ toast("Tokens acabaram! Ganhe mais acertando rodadas"); return; }
  const ans = list[ansIdx];
  const hidden = [...ans].map((ch,k)=>k).filter(k=>/[\p{L}\p{N}]/u.test(ans[k]) && !revealed.has(k));
  if (!hidden.length){ toast("Tudo revelado"); return; }
  revealed.add(hidden[Math.floor(Math.random()*hidden.length)]);
  coins -= HINT_COST; saveTokens(); render();
};
$("helpBtn").onclick = ()=>$("modal").classList.add("show");
$("closeModal").onclick = ()=>$("modal").classList.remove("show");
function buildPicker(){
  const g = $("catGrid"); g.innerHTML = "";
  const r = document.createElement("button");
  r.className = "rnd"; r.textContent = "🎲 Aleatório (todas as categorias)";
  r.onclick = ()=>{ randomMode = true; $("catModal").classList.remove("show"); newGame(); };
  g.appendChild(r);
  Object.keys(LISTS).forEach(n=>{
    const b = document.createElement("button");
    b.className = (!randomMode && n===cat) ? "on" : "";
    b.textContent = n + " (" + LISTS[n].length + ")";
    b.onclick = ()=>{ randomMode = false; cat = n; $("catModal").classList.remove("show"); newGame(); };
    g.appendChild(b);
  });
}
$("catBtn").onclick = ()=>{ buildPicker(); $("catModal").classList.add("show"); };
$("closeCat").onclick = ()=>$("catModal").classList.remove("show");
$("diceBtn").onclick = ()=>{ randomMode = true; newGame(); };
newGame();

