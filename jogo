    ["Qual empresa é dona do TikTok?","ByteDance","Meta","Google","Tencent"]
  ],
  "🎨 Cultura Geral": [
    ["Quantas cores tem o arco-íris?","7","5","6","8"],
    ["Quem pintou a Mona Lisa?","Leonardo da Vinci","Michelangelo","Van Gogh","Picasso"],
    ["Quem escreveu “Dom Casmurro”?","Machado de Assis","José de Alencar","Monteiro Lobato","Graciliano Ramos"],
    ["Qual instrumento musical tem 88 teclas?","Piano","Violão","Acordeão","Flauta"],
    ["Qual é a moeda do Japão?","Iene","Won","Yuan","Rupia"],
    ["Quantos lados tem um hexágono?","6","5","7","8"],
    ["Qual é o maior animal terrestre?","Elefante-africano","Girafa","Rinoceronte","Hipopótamo"],
    ["Quem é conhecido como o “Rei do Pop”?","Michael Jackson","Elvis Presley","Prince","Justin Timberlake"]
  ]
};
const QN = 10;
let qSel = new Set(), qList = [], qI = 0, qScore = 0, qAnswered = false;
const shuffle = a => { a = a.slice(); for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; };

function qRenderCats(){
  const box = $("qCats"); box.innerHTML = "";
  const rnd = document.createElement("button");
  rnd.className = "qcat" + (qSel.size===0 ? " on" : "");
  rnd.textContent = "🎲 Aleatório (todas)";
  rnd.onclick = ()=>{ qSel.clear(); qRenderCats(); };
  box.appendChild(rnd);
  Object.keys(QUIZ).forEach(n=>{
    const b = document.createElement("button");
    b.className = "qcat" + (qSel.has(n) ? " on" : "");
    b.textContent = n;
    b.onclick = ()=>{ qSel.has(n) ? qSel.delete(n) : qSel.add(n); qRenderCats(); };
    box.appendChild(b);
  });
}
function qShow(id){ ["qSetup","qPlay","qEnd"].forEach(x=>$(x).style.display = x===id ? "block" : "none"); }
function qStart(){
  const cats = qSel.size ? [...qSel] : Object.keys(QUIZ);
  const pool = [];
  cats.forEach(c => QUIZ[c].forEach(q => pool.push({cat:c, q:q[0], a:q[1], opts:q.slice(1)})));
  qList = shuffle(pool).slice(0, QN);
  qI = 0; qScore = 0;
  qShow("qPlay"); qRenderQ();
}
function qRenderQ(){
  const it = qList[qI]; qAnswered = false;
  $("qProg").textContent = (qI+1) + "/" + qList.length;
  $("qCat").textContent = it.cat;
  $("qScore").textContent = qScore + " pts";
  $("qBar").style.width = (qI/qList.length*100) + "%";
  $("qText").textContent = it.q;
  $("qNext").style.display = "none";
  const box = $("qOpts"); box.innerHTML = "";
  shuffle(it.opts).forEach(o=>{
    const b = document.createElement("button");
    b.className = "qopt"; b.textContent = o;
    b.onclick = ()=>qAnswer(b, o);
    box.appendChild(b);
  });
}
function qAnswer(btn, o){
  if (qAnswered) return; qAnswered = true;
  const it = qList[qI], right = o === it.a;
  if (right) qScore++;
  [...$("qOpts").children].forEach(b=>{
    b.disabled = true;
    if (b.textContent === it.a) b.classList.add("ok");
    else if (b === btn) b.classList.add("bad");
  });
  $("qScore").textContent = qScore + " pts";
  $("qBar").style.width = ((qI+1)/qList.length*100) + "%";
  $("qNext").textContent = qI === qList.length-1 ? "Ver resultado" : "Próxima";
  $("qNext").style.display = "block";
}
function qNext(){
  if (qI < qList.length-1){ qI++; qRenderQ(); return; }
  const pct = qScore / qList.length;
  $("qEndT").textContent = qScore + " de " + qList.length + " acertos";
  $("qEndS").textContent = pct===1 ? "🏆 Perfeito!" : pct>=.7 ? "👏 Mandou muito bem!" : pct>=.4 ? "🙂 Dá pra melhorar!" : "😅 Tente de novo!";
  qShow("qEnd");
}
$("qStart").onclick = qStart;
$("qNext").onclick = qNext;
$("qAgain").onclick = qStart;
$("qMenu").onclick = ()=>{ qRenderCats(); qShow("qSetup"); };
function setMode(m){
  $("listView").style.display = m==="list" ? "block" : "none";
  $("quizView").style.display = m==="quiz" ? "block" : "none";
  $("modeList").classList.toggle("on", m==="list");
  $("modeQuiz").classList.toggle("on", m==="quiz");
}
$("modeList").onclick = ()=>setMode("list");
$("modeQuiz").onclick = ()=>{ setMode("quiz"); };
qRenderCats();
</script>
</body>
</html>
